{
  "name": "@hobiri/pluma-vite",
  "version": "0.1.0",
  "description": "Build-time Vite plugins for Pluma applications.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "$npm_execpath run build && node --test dist/__tests__/routes.test.js dist/__tests__/overrides.test.js"
  },
  "keywords": [
    "hobiri",
    "pluma",
    "vite-plugin"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "peerDependencies": {
    "vite": "^7.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
